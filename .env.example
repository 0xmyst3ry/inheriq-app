# Optional. You can skip this file and add everything from the Connections tab instead.

# Quick start with Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Or any OpenAI-compatible API (OpenAI, OpenRouter, Together, Ollama, LM Studio, your own gateway)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Turns on the inbound API (POST /api/inbound/:agent). Use a long random value.
INHERIQ_API_TOKEN=

# PORT=3000
# HOST=127.0.0.1
# INHERIQ_DATA=./data
